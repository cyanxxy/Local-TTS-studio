strict-allow-scripts=true
; `strict-allow-scripts` and the `allowScripts` map in package.json are only understood by
; npm >= 11.17.0; older npm silently ignores them and runs every install script. `engines.npm`
; alone is just an EBADENGINE warning, so `engine-strict` is what makes the install refuse to
; proceed under an npm where the policy would be inert.
engine-strict=true
