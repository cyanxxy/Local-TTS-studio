{
  "name": "offline-voice-studio",
  "private": true,
  "version": "1.8.3",
  "description": "A local-first text-to-speech studio for the web and desktop.",
  "author": "cyanxxy",
  "license": "Apache-2.0",
  "homepage": "https://github.com/cyanxxy/Local-TTS-studio#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cyanxxy/Local-TTS-studio.git"
  },
  "type": "module",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || ^26.0.0",
    "npm": ">=11.17.0"
  },
  "main": "dist-electron/main.js",
  "scripts": {
    "setup:web": "node scripts/setup.mjs --web",
    "setup:desktop": "node scripts/setup.mjs --desktop",
    "doctor:desktop": "node scripts/setup.mjs --desktop --check",
    "dev": "npm run dev:web",
    "dev:web": "vite --port 5173",
    "build:rust": "node scripts/build-rust-bridge.mjs",
    "build:electron:main": "npm run build:rust && node -e \"require('node:fs').rmSync('dist-electron', { recursive: true, force: true })\" && tsc -p tsconfig.electron.json && esbuild electron/preload.ts --bundle --platform=node --format=cjs --target=node24 --external:electron --outfile=dist-electron/preload.js && node -e \"require('node:fs').copyFileSync('electron/package.json', 'dist-electron/package.json')\"",
    "dev:desktop": "npm run build:electron:main && concurrently \"npm run dev:web\" \"wait-on http://localhost:5173/desktop/studio && electron .\"",
    "dev:electron": "npm run dev:desktop",
    "build": "npm run build:web",
    "build:web": "tsc -b && vite build",
    "build:desktop": "npm run build:web && npm run build:electron:main",
    "build:electron": "npm run build:desktop",
    "dist": "npm run build:electron && electron-builder",
    "dist:mac": "npm run build:electron && electron-builder --mac --arm64",
    "dist:win": "npm run build:electron && electron-builder --win --x64",
    "dist:signed:mac": "npm run build:electron && electron-builder --config electron-builder.release.mjs --mac --arm64",
    "dist:signed:win": "npm run build:electron && electron-builder --config electron-builder.release.mjs --win --x64",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:rust": "node scripts/lint-rust-bridge.mjs",
    "typecheck": "tsc -b --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test": "npm run test:js && npm run test:rust",
    "test:js": "vitest run",
    "test:rust": "node scripts/test-rust-bridge.mjs",
    "test:audio8-smoke": "npm run build:electron:main && node scripts/smoke-audio8-native.cjs",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "eval:inference": "node scripts/inference-speed-eval.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "4.2.0",
    "@llamaindex/liteparse": "2.11.1",
    "onnxruntime-node": "1.27.0"
  },
  "devDependencies": {
    "@breezystack/lamejs": "1.2.7",
    "@electron/asar": "4.2.1",
    "@eslint/js": "9.39.5",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/literata": "5.3.0",
    "@fontsource-variable/outfit": "5.3.0",
    "@mozilla/readability": "0.6.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/coverage-istanbul": "4.1.10",
    "concurrently": "10.0.4",
    "electron": "43.4.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.4",
    "fake-indexeddb": "6.2.5",
    "fflate": "0.8.3",
    "globals": "17.10.0",
    "jsdom": "30.0.1",
    "kokoro-js": "1.2.1",
    "lucide-react": "1.31.0",
    "onnxruntime-web": "1.26.0-dev.20260416-b7804b056c",
    "onnxruntime-common": "1.27.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.1",
    "vitest": "4.1.10",
    "wait-on": "9.1.0"
  },
  "overrides": {
    "onnxruntime-node": "1.27.0"
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "onnxruntime-node@1.27.0": true,
    "protobufjs": false,
    "sharp@0.34.5": true
  },
  "build": {
    "appId": "com.opentts.desktop",
    "productName": "Open TTS",
    "mac": {
      "artifactName": "Open-TTS-${version}-macOS-${arch}-unsigned.${ext}",
      "category": "public.app-category.productivity",
      "minimumSystemVersion": "26.0",
      "identity": null,
      "hardenedRuntime": false,
      "notarize": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "files": [
        "dist/**/*",
        "dist-electron/**/*",
        "!dist-electron/**/*.test.js",
        "!**/node_modules/onnxruntime-node/bin/napi-v6/linux{,/**/*}",
        "!**/node_modules/onnxruntime-node/bin/napi-v6/win32{,/**/*}"
      ],
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "artifactName": "Open-TTS-${version}-Windows-${arch}-CPU-unsigned.${ext}",
      "files": [
        "dist/**/*",
        "dist-electron/**/*",
        "!dist-electron/**/*.test.js",
        "!**/node_modules/onnxruntime-node/bin/napi-v6/linux{,/**/*}",
        "!**/node_modules/onnxruntime-node/bin/napi-v6/darwin{,/**/*}",
        "!**/node_modules/onnxruntime-node/bin/napi-v6/win32/!(${arch}){,/**/*}"
      ],
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true
    },
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "!dist-electron/**/*.test.js",
      "!**/node_modules/onnxruntime-node/bin/napi-v6/linux{,/**/*}"
    ],
    "asarUnpack": [
      "**/node_modules/@img/**",
      "**/node_modules/@llamaindex/**",
      "**/node_modules/onnxruntime-node/**",
      "**/node_modules/sharp/**"
    ],
    "afterPack": "scripts/verify-electron-package.mjs",
    "extraResources": [
      {
        "from": "dist-rust",
        "to": "dist-rust",
        "filter": [
          "**/*"
        ]
      }
    ],
    "directories": {
      "output": "release"
    }
  }
}
