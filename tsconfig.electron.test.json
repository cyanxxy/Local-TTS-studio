{
  /* Typecheck-only companion to tsconfig.electron.json. The build config must keep
     excluding tests so they never land in dist-electron, so the tests get their own
     project here. Vitest executes these files as ESM, hence the module overrides:
     `import.meta` is unavailable under the build's CommonJS setting. */
  "extends": "./tsconfig.electron.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.electron.test.tsbuildinfo",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "noEmit": true
  },
  "include": ["electron"],
  "exclude": []
}
